# 本地配置模板
# 复制为 src/main/resources/application-local.yml 后修改（该路径已 gitignore）

spring:
  datasource:
    url: jdbc:h2:mem:scaffold;MODE=MYSQL;DB_CLOSE_DELAY=-1
    driver-class-name: org.h2.Driver
    username: sa
    password:
  jpa:
    hibernate:
      ddl-auto: update

server:
  port: 8080

logging:
  level:
    com.example.scaffold: DEBUG

# 外部数据库示例：
