#   datasource:
#     url: jdbc:mysql://localhost:3306/scaffold?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
#     driver-class-name: com.mysql.cj.jdbc.Driver
#     username: ${DB_USER}
#     password: ${DB_PASSWORD}
